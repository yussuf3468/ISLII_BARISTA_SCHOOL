# ─────────────────────────────────────────────────────────────────────────────
#  Copy to .env.local and fill in from Supabase → Project Settings → API.
#  .env.local is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️  NEVER add the service_role key here, or to any VITE_-prefixed variable.
#     Vite compiles every VITE_ value into the JavaScript that ships to the
#     browser. The anon key is designed to be public and is powerless without
#     the RLS policies' permission; the service_role key bypasses RLS entirely
#     and belongs only in Supabase Edge Function secrets:
#
#       supabase secrets set SITE_URL=https://isliibarista.com
#
#     (SUPABASE_SERVICE_ROLE_KEY is injected into functions automatically.)
